{
  "name": "ai-native-quality-harness",
  "version": "1.0.0",
  "description": "Enterprise-ready centralized quality engineering framework for modern web applications, microservices, and AI-first agentic platforms",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:e2e": "playwright test tests/e2e",
    "test:api": "playwright test tests/api",
    "test:ai": "playwright test tests/ai-features",
    "test:parallel": "playwright test --workers=4",
    "test:headed": "playwright test --headed",
    "report": "playwright show-report",
    "docker:build": "docker build -f docker/Dockerfile -t ai-quality-harness:latest .",
    "docker:compose": "docker-compose -f docker/docker-compose.yml up",
    "lint": "eslint src tests --ext .ts",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "quality-assurance",
    "test-automation",
    "playwright",
    "ai-evaluation",
    "llm-testing"
  ],
  "author": "kishorekr1",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.3.3",
    "eslint": "^8.54.0",
    "@typescript-eslint/eslint-plugin": "^6.13.2",
    "@typescript-eslint/parser": "^6.13.2",
    "prettier": "^3.1.0"
  },
  "dependencies": {
    "axios": "^1.6.2",
    "dotenv": "^16.3.1",
    "openai": "^4.24.1"
  }
}
